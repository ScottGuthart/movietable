      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(xcodebuild *)",
      "Bash(xcrun *)",
      "Bash(xcode-select *)",
      "Bash(swift *)",
      "Bash(xcbeautify *)",
      "Bash(plutil *)",
      "Bash(git *)",
